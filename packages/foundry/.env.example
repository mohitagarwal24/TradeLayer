# Copy to .env. Forge auto-loads this file, so keep live keys out of it on shared machines.

# Deployer for live networks (Hedera testnet). `yarn generate` creates one; fund it at
# https://portal.hedera.com/faucet. Anvil ignores this and uses its well-known account #0.
PRIVATE_KEY=

# Address of the enclave's EIP-712 signing key. The three contracts trust only this address.
# Anvil default: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8 (account #1).
ENCLAVE_SIGNER=

# ATS equity diamonds created in the Asset Tokenization Studio web UI (EVM addresses).
ATS_TSLA=
ATS_VOO=

# Leave empty to have the deploy script create the company token through the vault
# (costs TOKEN_CREATE_HBAR_WEI); set to adopt an existing token with the vault as treasury.
COMPANY_TOKEN=
TOKEN_CREATE_HBAR_WEI=20000000000000000000
# HBAR the escrow holds to pay for its own HIP-1215 scheduled refunds.
ESCROW_HBAR_WEI=5000000000000000000

# Verification (Sourcify for Hedera needs no key).
ETHERSCAN_API_KEY=
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default

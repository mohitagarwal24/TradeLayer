# Alpaca brokerage credentials — get these from https://app.alpaca.markets/
# Use PAPER trading keys. NEVER commit real values. A previous version of this
# repo leaked a key pair into git history; treat those as compromised/revoked.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Set to "false" only for live trading. Defaults to paper trading.
ALPACA_PAPER=true

# Hedera testnet (chain 296)
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Optional: only if you have a working WS endpoint; JSON-RPC polling is default.
HEDERA_WS_URL=

# Backend settle wallet: EVM private key whose address was set as backendWallet
# on TradeLayer (via setBackendWallet) and holds a little HBAR for gas.
private_key=

# Deployed TradeLayer proxy/contract address from `yarn deploy:hedera-testnet`
contract=

# Order-privacy ECDH keypair (base64-encoded JWK). On first run the server
# generates one and prints it — paste it here and restart.
BACKEND_ECDH_JWK=

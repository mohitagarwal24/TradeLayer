# Alpaca brokerage credentials — get these from https://app.alpaca.markets/
# NEVER commit real values. A previous version of this repo leaked a key pair
# into git history; those keys must be treated as compromised and revoked.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Set to "false" only for live trading. Defaults to paper trading.
ALPACA_PAPER=true

# Chain / contract
alchemy_rpc_url=
private_key=
contract=

# ECDH keypair (base64-encoded JWK) used to decrypt user order intents
BACKEND_PRIVATE_KEY=
USER_PUBLIC_KEY=

# --- network (Hedera testnet only) ---
CHAIN_ID=296
RPC_URL=https://testnet.hashio.io/api

# --- contracts (from `yarn deploy:hedera-testnet` output) ---
ORDER_ESCROW=
CONFIDENTIAL_LEDGER=
OMNIBUS_VAULT=
ORG_WALLET_REGISTRY=
COMPLIANCE_ROUTER=

# Tickers the platform has issued an ATS equity for. The UI will not offer anything else.
SYMBOLS=F,TSLA,VOO

# --- keys ---
# Address of the enclave's signing key. Must equal enclaveSigner() on escrow, ledger and vault.
ENCLAVE_SIGNER=
# Hot key that pays gas. It can only relay what the enclave signed — it cannot forge.
RELAYER_PRIVATE_KEY=
# Compressed secp256k1 public key (0x02/0x03 + 32 bytes) that clients seal intents to.
INTENT_PUBKEY=

# --- market data (read-only, for showing live prices in the UI) ---
# Deliberately NOT the trading credentials: those are Vault DON secrets that exist only inside
# the enclave. Quotes are public information; the ability to place an order is not.
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET=

# --- how envelopes reach the enclave ---
# simulate: spawn `cre workflow simulate` (needs `cre login`)  |  gateway: CRE HTTP trigger  |  none
TRIGGER_MODE=simulate
CRE_PROJECT_DIR=../cre
CRE_WORKFLOW_DIR=tradelayer
CRE_TARGET=testnet-settings
CRE_BIN=cre
CRE_GATEWAY_URL=
CRE_ENV_FILE=.env
# The CLI shells out to bun; set if a service PATH lacks bun/cre
CRE_EXTRA_PATH=
CRE_ALLOW_INSECURE_RPC=true

# --- server ---
PORT=8000
FRONTEND_ORIGIN=http://localhost:8080
DATA_DIR=.data
# How often to poll the chain for events to narrate
WATCH_POLL_MS=4000

# Hedera under-estimates gas for HTS-touching calls; send an explicit floor.
RELAY_GAS_LIMIT=4000000

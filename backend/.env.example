# Alpaca brokerage credentials — get these from https://app.alpaca.markets/
# Use PAPER trading keys. NEVER commit real values.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Hedera testnet (chain 296)
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_WS_URL=

# Backend settle wallet (EVM) — must match TradeLayer.backendWallet
private_key=
contract=

# Pyth guard applied to every Alpaca fill before private on-chain settlement
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_MAX_AGE_SECONDS=90
PYTH_MAX_CONFIDENCE_BPS=100
PYTH_MAX_FILL_DEVIATION_BPS=500
FRONTEND_ORIGIN=http://localhost:8080

# Order-privacy ECDH keypair (base64-encoded JWK)
BACKEND_ECDH_JWK=

# --- x402 / Blocky402 (agentic payments prize) ---
# Merchant Hedera account that receives pay-per-call fees
X402_PAY_TO=
# HTS USDC on Hedera testnet (0.0.429274). Use 0.0.0 for HBAR micropayments.
X402_ASSET=0.0.429274
# Amount in asset base units (USDC 6 decimals → 10000 = $0.01)
X402_AMOUNT=10000
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Autonomous x402 payer used by scripts/x402Agent.ts
X402_PAYER_ACCOUNT_ID=
X402_PAYER_PRIVATE_KEY=

# Optional HCS payment audit trail (extra points)
HCS_AUDIT_TOPIC=
HCS_OPERATOR_ACCOUNT_ID=
HCS_OPERATOR_PRIVATE_KEY=
# HTS USDC token id used by scripts/associateUsdc.ts (default 0.0.429274)
USDC_TOKEN_ID=
ASSOCIATE_ACCOUNT_ID=
ASSOCIATE_PRIVATE_KEY=

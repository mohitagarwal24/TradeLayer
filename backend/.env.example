# Alpaca brokerage credentials — get these from https://app.alpaca.markets/
# Use PAPER trading keys. NEVER commit real values.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Hedera testnet (chain 296)
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_WS_URL=

# Backend settle wallet (EVM) — must match TradeLayer.backendWallet
private_key=
contract=

# Order-privacy ECDH keypair (base64-encoded JWK)
BACKEND_ECDH_JWK=

# --- x402 / Blocky402 (agentic payments prize) ---
# Merchant Hedera account that receives pay-per-call fees
X402_PAY_TO=
# HTS USDC on Hedera testnet (0.0.429274). Use 0.0.0 for HBAR micropayments.
X402_ASSET=0.0.429274
# Amount in asset base units (USDC 6 decimals → 10000 = $0.01)
X402_AMOUNT=10000
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Optional HCS payment audit trail (extra points)
HCS_AUDIT_TOPIC=
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

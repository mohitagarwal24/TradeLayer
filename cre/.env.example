# Simulation-time values for the secrets declared in secrets.yaml.
# In production these live in the Vault DON and are released only to an attested enclave.
# Generate fresh keys for the demo; never reuse a funded wallet here.

# secp256k1 private key (0x-prefixed, 32 bytes) whose *public* key clients seal intents to.
CRE_INTENT_PRIVKEY=

# 32 random bytes, hex. Per-account portfolio keys are HKDF-derived from this.
CRE_LEDGER_MASTER_KEY=

# secp256k1 private key whose address is `enclaveSigner` on all three contracts.
# On Anvil the deploy script defaults this to account #1:
# Generate a fresh one; its address must equal ENCLAVE_SIGNER on the deployed contracts.
CRE_ENCLAVE_SIGNING_KEY=

# Alpaca paper-trading credentials. Leave blank when config.broker.mock = true.
CRE_ALPACA_KEY_ID=
CRE_ALPACA_SECRET_KEY=
